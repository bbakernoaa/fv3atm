[ccpp-table-properties]
  name = CCPP_data
  type = host
  dependencies = CCPP_typedefs.F90,GFS_typedefs.F90

[ccpp-arg-table]
  name = CCPP_data
  type = host
[GFDL_interstitial]
  standard_name = GFDL_interstitial_type_instance
  long_name = instance of derived type GFDL_interstitial_type
  units = DDT
  dimensions = ()
  type = GFDL_interstitial_type
[GFS_Control]
  standard_name = GFS_control_type_instance
  long_name = instance of derived type GFS_control_type
  units = DDT
  dimensions = ()
  type = GFS_control_type
[GFS_Statein]
  standard_name = GFS_statein_type_instance
  long_name = prognostic state data in from dycore
  units = DDT
  dimensions = ()
  type = GFS_statein_type
[GFS_Stateout]
  standard_name = GFS_stateout_type_instance
  long_name = prognostic state or tendencies return to dycore
  units = DDT
  dimensions = ()
  type = GFS_stateout_type
[GFS_Grid]
  standard_name = GFS_grid_type_instance
  long_name = instance of derived type GFS_grid_type
  units = DDT
  dimensions = ()
  type = GFS_grid_type
[GFS_Tbd]
  standard_name = GFS_tbd_type_instance
  long_name = instance of derived type GFS_tbd_type
  units = DDT
  dimensions = ()
  type = GFS_tbd_type
[GFS_Cldprop]
  standard_name = GFS_cldprop_type_instance
  long_name = instance of derived type GFS_cldprop_type
  units = DDT
  dimensions = ()
  type = GFS_cldprop_type
[GFS_Sfcprop]
  standard_name = GFS_sfcprop_type_instance
  long_name = instance of derived type GFS_sfcprop_type
  units = DDT
  dimensions = ()
  type = GFS_sfcprop_type
[GFS_Radtend]
  standard_name = GFS_radtend_type_instance
  long_name = instance of derived type GFS_radtend_type
  units = DDT
  dimensions = ()
  type = GFS_radtend_type
[GFS_Coupling]
  standard_name = GFS_coupling_type_instance
  long_name = instance of derived type GFS_coupling_type
  units = DDT
  dimensions = ()
  type = GFS_coupling_type
[GFS_Intdiag]
  standard_name = GFS_diag_type_instance
  long_name = instance of derived type GFS_diag_type
  units = DDT
  dimensions = ()
  type = GFS_diag_type
[GFS_Interstitial]
  standard_name = GFS_interstitial_type_instance
  long_name = instance of derived type GFS_interstitial_type
  units = DDT
  dimensions = (number_of_threads)
  type = GFS_interstitial_type
[catchem_context_id]
  standard_name = catchem_context_id
  long_name = UFS-owned CATChem context slot
  units = 1
  dimensions = ()
  type = integer | kind = c_int
[catchem_context_generation]
  standard_name = catchem_context_generation
  long_name = UFS-owned CATChem context generation
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
[catchem_interval_id]
  standard_name = catchem_interval_id
  long_name = UFS host physics interval identity
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
[catchem_interval_token]
  standard_name = catchem_interval_token
  long_name = UFS host physics interval token
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
[catchem_year]
  standard_name = catchem_year
  long_name = Current host year for CATChem's selected interval
  units = 1
  dimensions = ()
  type = integer
[catchem_month]
  standard_name = catchem_month
  long_name = Current host month for CATChem's selected interval
  units = 1
  dimensions = ()
  type = integer
[catchem_day]
  standard_name = catchem_day
  long_name = Current host day for CATChem's selected interval
  units = 1
  dimensions = ()
  type = integer
[catchem_hour]
  standard_name = catchem_hour
  long_name = Current host hour for CATChem's selected interval
  units = 1
  dimensions = ()
  type = integer
[catchem_minute]
  standard_name = catchem_minute
  long_name = Current host minute for CATChem's selected interval
  units = 1
  dimensions = ()
  type = integer
[catchem_second]
  standard_name = catchem_second
  long_name = Current host second for CATChem's selected interval
  units = 1
  dimensions = ()
  type = integer
[catchem_day_of_year]
  standard_name = catchem_day_of_year
  long_name = Current host day of year for CATChem's selected interval
  units = 1
  dimensions = ()
  type = integer
[catchem_duration_seconds]
  standard_name = catchem_duration_seconds
  long_name = Duration of the current host interval
  units = s
  dimensions = ()
  type = real | kind = kind_phys
[catchem_process_subcycle]
  standard_name = catchem_process_subcycle
  long_name = CATChem process subcycle phase within the physics timestep
  units = 1
  dimensions = ()
  type = integer | kind = c_int
[catchem_coupling_site]
  standard_name = catchem_coupling_site
  long_name = CATChem host coupling site name
  units = none
  dimensions = ()
  type = character | kind = len=256
